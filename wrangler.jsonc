{
  "name": "perpetuum-havel-site-claude",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./out"
  },
  // Vlastní domény. Nasazení na nich projde jen se zónou ve stavu Active —
  // dokud registr vydává cizí nameservery, build na tomhle selže.
  "routes": [
    { "pattern": "perpetuumhavel.cz", "custom_domain": true },
    { "pattern": "www.perpetuumhavel.cz", "custom_domain": true }
  ]
}
